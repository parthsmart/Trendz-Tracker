{
  "buildCommand": "npm run build",
  "installCommand": "npm ci || npm install",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": {
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/jmcwc-drive-sync",
      "destination": "/api/jmcwc?drive_sync=1"
    },
    {
      "source": "/api/lectures",
      "destination": "/api/live-class?catalogue=lectures"
    },
    {
      "source": "/api/lectures.js",
      "destination": "/api/live-class?catalogue=lectures"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.(webmanifest|json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-report",
      "schedule": "30 15 * * 0"
    },
    {
      "path": "/api/backup",
      "schedule": "30 20 * * *"
    }
  ]
}
