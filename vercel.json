{
  "buildCommand": "npm run build",
  "installCommand": "npm ci || npm install",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-report",
      "schedule": "30 15 * * 0"
    },
    {
      "path": "/api/backup",
      "schedule": "30 20 * * *"
    }
  ]
}
