br>                },<br>                {<br>                    "name": "category_key",<br>                    "type": "text",<br>                    "default": null,<br>                    "not_null": true<br>                },<br>                {<br>                    "name": "target_seconds",<br>                    "type": "integer",<br>                    "default": null,<br>                    "not_null": false<br>                },<br>                {<br>                    "name": "updated_at",<br>                    "type": "timestamp with time zone",<br>                    "default": "now()",<br>                    "not_null": true<br>                }<br>            ],<br>            "indexes": [<br>                "CREATE UNIQUE INDEX jmcwc_targets_pkey ON public.jmcwc_targets USING btree (group_key, category_key)"<br>            ],<br>            "triggers": null,<br>            "constraints": [<br>                {<br>                    "name": "jmcwc_targets_category_key_fkey",<br>                    "definition": "FOREIGN KEY (category_key) REFERENCES jmcwc_categories(key)"<br>                },<br>                {<br>                    "name": "jmcwc_targets_group_key_check",<br>                    "definition": "CHECK (group_key = ANY (ARRAY['junior1'::text, 'junior2'::text, 'senior'::text]))"<br>                },<br>                {<br>                    "name": "jmcwc_targets_pkey",<br>                    "definition": "PRIMARY KEY (group_key, category_key)"<br>                },<br>                {<br>                    "name": "jmcwc_targets_target_seconds_check",<br>                    "definition": "CHECK (target_seconds > 0 AND target_seconds <= 86400)"<br>                }<br>            ],<br>            "permissions": "{postgres=arwdDxtm/postgres,service_role=arwdDxtm/postgres}",<br>            "rls_enabled": true<br>        }<br>    ],<br>    "purpose": "Read-only snapshot of deployed JMCWC contract",<br>    "policies": [<br>    ],<br>    "functions": [<br>        {<br>            "name": "jmcwc_act",<br>            "definition": "CREATE OR REPLACE FUNCTION public.jmcwc_act(p_student uuid, p_attempt uuid, p_action text, p_lease uuid DEFAULT NULL::uuid, p_seq bigint DEFAULT NULL::bigint, p_answers jsonb DEFAULT NULL::jsonb)\\n RETURNS jsonb\\n LANGUAGE plpgsql\\n SET search_path TO ''\\nAS $function$\\r\\nDECLARE\\r\\n  a public.jmcwc_attempts;\\r\\n  other uuid;\\r\\n  g text;\\r\\n  entry record;\\r\\n  token uuid;\\r\\nBEGIN\\r\\n  PERFORM pg_advisory_xact_lock(\\r\\n    hashtextextended(p_student::text,172026)\\r\\n  );\\r\\n\\r\\n  g:=public.jmcwc_check_student(p_student);\\r\\n\\r\\n  SELECT * INTO a\\r\\n  FROM public.jmcwc_attempts\\r\\n  WHERE id=p_attempt AND student_id=p_student\\r\\n  FOR UPDATE;\\r\\n\\r\\n  IF NOT FOUND THEN\\r\\n    RAISE EXCEPTION 'Round not found.';\\r\\n  END IF;\\r\\n\\r\\n  IF a.group_key<>g AND a.status<>'submitted' THEN\\r\\n    RAISE EXCEPTION\\r\\n      'This round belongs to a different assigned group.';\\r\\n  END IF;\\r\\n\\r\\n  IF p_action NOT IN (\\r\\n    'read','resume','save','heartbeat','pause','submit'\\r\\n  ) OR p_action IS NULL\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Unknown action.';\\r\\n  END IF;\\r\\n\\r\\n  IF p_action IN ('save','heartbeat','pause','submit')\\r\\n     AND a.status='running'\\r\\n     AND (p_lease IS NULL OR p_lease IS DISTINCT FROM a.lease_id)\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Session changed. Reload this round.';\\r\\n  END IF;\\r\\n\\r\\n  PERFORM public.jmcwc_tick(a.id);\\r\\n\\r\\n  SELECT * INTO a\\r\\n  FROM public.jmcwc_attempts\\r\\n  WHERE id=a.id;\\r\\n\\r\\n  IF a.status IN ('grading','submitted') THEN\\r\\n    RETURN to_jsonb(a);\\r\\n  END IF;\\r\\n\\r\\n  IF p_action='resume' THEN\\r\\n    FOR other IN\\r\\n      SELECT id\\r\\n      FROM public.jmcwc_attempts\\r\\n      WHERE student_id=p_student AND status='running'\\r\\n    LOOP\\r\\n      PERFORM public.jmcwc_tick(other);\\r\\n\\r\\n      UPDATE public.jmcwc_attempts\\r\\n      SET status='paused',\\r\\n          lease_id=NULL,\\r\\n          last_seen_at=NULL,\\r\\n          revision=revision+1\\r\\n      WHERE id=other AND status='running';\\r\\n    END LOOP;\\r\\n\\r\\n    SELECT status INTO a.status\\r\\n    FROM public.jmcwc_attempts\\r\\n    WHERE id=a.id;\\r\\n\\r\\n    IF a.status='grading' THEN\\r\\n      SELECT * INTO a\\r\\n      FROM public.jmcwc_attempts\\r\\n      WHERE id=a.id;\\r\\n\\r\\n      RETURN to_jsonb(a);\\r\\n    END IF;\\r\\n\\r\\n    token:=gen_random_uuid();\\r\\n\\r\\n    UPDATE public.jmcwc_attempts\\r\\n    SET status='running',\\r\\n        lease_id=token,\\r\\n        save_seq=-1,\\r\\n        last_seen_at=clock_timestamp(),\\r\\n        revision=revision+1\\r\\n    WHERE id=a.id;\\r\\n\\r\\n  ELSIF p_action IN ('save','heartbeat','pause','submit') THEN\\r\\n    IF a.status<>'running' THEN\\r\\n      RETURN to_jsonb(a);\\r\\n    END IF;\\r\\n\\r\\n    IF p_answers IS NOT NULL THEN\\r\\n      IF jsonb_typeof(p_answers)<>'object'\\r\\n         OR octet_length(p_answers::text)>250000\\r\\n         OR p_seq IS NULL\\r\\n         OR p_seq<0\\r\\n      THEN\\r\\n        RAISE EXCEPTION 'Invalid answer patch.';\\r\\n      END IF;\\r\\n\\r\\n      IF p_seq>a.save_seq THEN\\r\\n        FOR entry IN\\r\\n          SELECT * FROM jsonb_each(p_answers)\\r\\n        LOOP\\r\\n          IF jsonb_typeof(entry.value) NOT IN ('string','null')\\r\\n             OR octet_length(entry.value::text)>4000\\r\\n             OR NOT EXISTS (\\r\\n               SELECT 1\\r\\n               FROM public.jmcwc_payloads pp\\r\\n               CROSS JOIN LATERAL\\r\\n                 jsonb_array_elements(pp.questions) q\\r\\n               WHERE pp.attempt_id=a.id\\r\\n                 AND q->>'id'=entry.key\\r\\n             )\\r\\n          THEN\\r\\n            RAISE EXCEPTION 'Invalid question or answer.';\\r\\n          END IF;\\r\\n        END LOOP;\\r\\n\\r\\n        UPDATE public.jmcwc_attempts\\r\\n        SET answers=answers\|\|p_answers,\\r\\n            save_seq=p_seq,\\r\\n            revision=revision+1\\r\\n        WHERE id=a.id;\\r\\n      END IF;\\r\\n    END IF;\\r\\n\\r\\n    IF p_action='pause' THEN\\r\\n      UPDATE public.jmcwc_attempts\\r\\n      SET status='paused',\\r\\n          lease_id=NULL,\\r\\n          last_seen_at=NULL,\\r\\n          revision=revision+1\\r\\n      WHERE id=a.id;\\r\\n\\r\\n    ELSIF p_action='submit' THEN\\r\\n      UPDATE public.jmcwc_attempts\\r\\n      SET status='grading',\\r\\n          lease_id=NULL,\\r\\n          last_seen_at=NULL,\\r\\n          finished_at=clock_timestamp(),\\r\\n          submitted_reason='early',\\r\\n          revision=revision+1\\r\\n      WHERE id=a.id;\\r\\n    END IF;\\r\\n  END IF;\\r\\n\\r\\n  SELECT * INTO a\\r\\n  FROM public.jmcwc_attempts\\r\\n  WHERE id=a.id;\\r\\n\\r\\n  RETURN to_jsonb(a);\\r\\nEND $function$\\n",<br>            "permissions": "{postgres=X/postgres,service_role=X/postgres}",<br>            "security_definer": false,<br>            "identity_arguments": "p_student uuid, p_attempt uuid, p_action text, p_lease uuid, p_seq bigint, p_answers jsonb"<br>        },<br>        {<br>            "name": "jmcwc_assignment_guard",<br>            "definition": "CREATE OR REPLACE FUNCTION public.jmcwc_assignment_guard()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO ''\\nAS $function$\\r\\nBEGIN\\r\\n  PERFORM pg_advisory_xact_lock(\\r\\n    hashtextextended(NEW.student_id::text,172026)\\r\\n  );\\r\\n\\r\\n  IF TG_OP='UPDATE'\\r\\n     AND NEW.group_key IS DISTINCT FROM OLD.group_key\\r\\n     AND EXISTS (\\r\\n       SELECT 1\\r\\n       FROM public.jmcwc_attempts\\r\\n       WHERE student_id=OLD.student_id\\r\\n         AND status<>'submitted'\\r\\n     )\\r\\n  THEN\\r\\n    RAISE EXCEPTION\\r\\n      'Complete this student''s unfinished simulator attempts before changing group.';\\r\\n  END IF;\\r\\n\\r\\n  IF NOT EXISTS (\\r\\n    SELECT 1\\r\\n    FROM public.profiles\\r\\n    WHERE id=NEW.student_id AND role='student'\\r\\n  )\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Assign a student account only.';\\r\\n  END IF;\\r\\n\\r\\n  NEW.updated_at:=clock_timestamp();\\r\\n  RETURN NEW;\\r\\nEND $function$\\n",<br>            "permissions": "{postgres=X/postgres,service_role=X/postgres}",<br>            "security_definer": false,<br>            "identity_arguments": ""<br>        },<br>        {<br>            "name": "jmcwc_check_student",<br>            "definition": "CREATE OR REPLACE FUNCTION public.jmcwc_check_student(p_student uuid)\\n RETURNS text\\n LANGUAGE plpgsql\\n SET search_path TO ''\\nAS $function$\\r\\nDECLARE\\r\\n  g text;\\r\\nBEGIN\\r\\n  IF NOT EXISTS (\\r\\n    SELECT 1\\r\\n    FROM public.profiles\\r\\n    WHERE id=p_student AND role='student' AND active\\r\\n  )\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'An active student account is required.';\\r\\n  END IF;\\r\\n\\r\\n  SELECT group_key INTO g\\r\\n  FROM public.jmcwc_assignments\\r\\n  WHERE student_id=p_student;\\r\\n\\r\\n  IF g IS NULL THEN\\r\\n    RAISE EXCEPTION\\r\\n      'Ask your teacher to assign your JMCWC group.';\\r\\n  END IF;\\r\\n\\r\\n  RETURN g;\\r\\nEND $function$\\n",<br>            "permissions": "{postgres=X/postgres,service_role=X/postgres}",<br>            "security_definer": false,<br>            "identity_arguments": "p_student uuid"<br>        },<br>        {<br>            "name": "jmcwc_create_attempt",<br>            "definition": "CREATE OR REPLACE FUNCTION public.jmcwc_create_attempt(p_student uuid, p_request uuid, p_paper uuid, p_mode text, p_category text, p_questions jsonb)\\n RETURNS uuid\\n LANGUAGE plpgsql\\n SET search_path TO ''\\nAS $function$\\r\\nDECLARE\\r\\n  g text;\\r\\n  p public.jmcwc_papers;\\r\\n  a uuid;\\r\\n  expected integer;\\r\\n  q jsonb;\\r\\n  blueprint_slot jsonb;\\r\\n  question_marks numeric;\\r\\n  target integer;\\r\\nBEGIN\\r\\n  PERFORM pg_advisory_xact_lock(\\r\\n    hashtextextended(p_student::text,172026)\\r\\n  );\\r\\n\\r\\n  g := public.jmcwc_check_student(p_student);\\r\\n\\r\\n  SELECT id INTO a\\r\\n  FROM public.jmcwc_attempts\\r\\n  WHERE student_id = p_student\\r\\n    AND request_id = p_request;\\r\\n\\r\\n  IF FOUND THEN\\r\\n    RETURN a;\\r\\n  END IF;\\r\\n\\r\\n  IF p_request IS NULL\\r\\n     OR p_mode IS NULL\\r\\n     OR p_mode NOT IN ('flat','category')\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Invalid request.';\\r\\n  END IF;\\r\\n\\r\\n  SELECT * INTO p\\r\\n  FROM public.jmcwc_papers\\r\\n  WHERE id = p_paper\\r\\n    AND group_key = g\\r\\n    AND published;\\r\\n\\r\\n  IF NOT FOUND THEN\\r\\n    RAISE EXCEPTION\\r\\n      'No published paper for your assigned group.';\\r\\n  END IF;\\r\\n\\r\\n  IF (p_mode = 'flat' AND p_category IS NOT NULL)\\r\\n     OR (p_mode = 'category' AND p_category IS NULL)\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Invalid category.';\\r\\n  END IF;\\r\\n\\r\\n  IF p_mode = 'flat'\\r\\n     AND (\\r\\n       SELECT count(*)\\r\\n       FROM public.jmcwc_attempts\\r\\n       WHERE student_id = p_student\\r\\n         AND mode = 'flat'\\r\\n         AND status <> 'submitted'\\r\\n     ) >= 3\\r\\n  THEN\\r\\n    RAISE EXCEPTION\\r\\n      'You have three unfinished flat rounds. Complete one before starting another.';\\r\\n  END IF;\\r\\n\\r\\n  SELECT count(*) INTO expected\\r\\n  FROM jsonb_array_elements(p.spec->'sections') s\\r\\n  CROSS JOIN LATERAL\\r\\n    jsonb_array_elements(s->'questions') item\\r\\n  WHERE p_mode = 'flat'\\r\\n     OR s->>'key' = p_category;\\r\\n\\r\\n  IF expected = 0\\r\\n     OR jsonb_typeof(p_questions)\\r\\n          IS DISTINCT FROM 'array'\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Invalid generated paper.';\\r\\n  END IF;\\r\\n\\r\\n  IF jsonb_array_length(p_questions) <> expected\\r\\n     OR octet_length(p_questions::text) > 5000000\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Paper size mismatch.';\\r\\n  END IF;\\r\\n\\r\\n  IF (\\r\\n    SELECT count(DISTINCT x->>'id')\\r\\n    FROM jsonb_array_elements(p_questions) x\\r\\n  ) <> expected\\r\\n  OR (\\r\\n    SELECT count(DISTINCT (x->>'category_key',x->>'slot'))\\r\\n    FROM jsonb_array_elements(p_questions) x\\r\\n  ) <> expected\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Duplicate question IDs or slots.';\\r\\n  END IF;\\r\\n\\r\\n  FOR q IN\\r\\n    SELECT * FROM jsonb_array_elements(p_questions)\\r\\n  LOOP\\r\\n    IF jsonb_typeof(q) IS DISTINCT FROM 'object'\\r\\n       OR coalesce(q->>'id','') = ''\\r\\n       OR length(q->>'id') > 100\\r\\n       OR NOT(q ? 'answer_key')\\r\\n       OR NOT(q ? 'prompt')\\r\\n       OR NOT(q ? 'input')\\r\\n       OR jsonb_typeof(q->'max_marks')\\r\\n            IS DISTINCT FROM 'number'\\r\\n    THEN\\r\\n      RAISE EXCEPTION 'Invalid generated question.';\\r\\n    END IF;\\r\\n\\r\\n    SELECT item INTO blueprint_slot\\r\\n    FROM jsonb_array_elements(p.spec->'sections') s\\r\\n    CROSS JOIN LATERAL\\r\\n      jsonb_array_elements(s->'questions') item\\r\\n    WHERE s->>'key' = q->>'category_key'\\r\\n      AND item->>'slot' = q->>'slot'\\r\\n      AND (\\r\\n        p_mode = 'flat'\\r\\n        OR s->>'key' = p_category\\r\\n      );\\r\\n\\r\\n    IF NOT FOUND THEN\\r\\n      RAISE EXCEPTION\\r\\n        'Question does not match the published blueprint.';\\r\\n    END IF;\\r\\n\\r\\n    question_marks := (q->>'max_marks')::numeric;\\r\\n\\r\\n    PERFORM public.jmcwc_validate_marks(\\r\\n      q->>'category_key',\\r\\n      blueprint_slot,\\r\\n      question_marks\\r\\n    );\\r\\n  END LOOP;\\r\\n\\r\\n  SELECT target_seconds INTO target\\r\\n  FROM public.jmcwc_targets\\r\\n  WHERE group_key = g\\r\\n    AND category_key = p_category;\\r\\n\\r\\n  INSERT INTO public.jmcwc_attempts(\\r\\n    student_id,\\r\\n    request_id,\\r\\n    paper_id,\\r\\n    group_key,\\r\\n    mode,\\r\\n    category_key,\\r\\n    target_seconds\\r\\n  )\\r\\n  VALUES(\\r\\n    p_student,\\r\\n    p_request,\\r\\n    p_paper,\\r\\n    g,\\r\\n    p_mode,\\r\\n    p_category,\\r\\n    CASE WHEN p_mode = 'category' THEN target END\\r\\n  )\\r\\n  RETURNING id INTO a;\\r\\n\\r\\n  INSERT INTO public.jmcwc_payloads(\\r\\n    attempt_id, questions\\r\\n  )\\r\\n  VALUES(a,p_questions);\\r\\n\\r\\n  RETURN a;\\r\\nEND;\\r\\n$function$\\n",<br>            "permissions": "{postgres=X/postgres,service_role=X/postgres}",<br>            "security_definer": false,<br>            "identity_arguments": "p_student uuid, p_request uuid, p_paper uuid, p_mode text, p_category text, p_questions jsonb"<br>        },<br>        {<br>            "name": "jmcwc_finalize",<br>            "definition": "CREATE OR REPLACE FUNCTION public.jmcwc_finalize(p_student uuid, p_attempt uuid, p_revision bigint, p_items jsonb)\\n RETURNS void\\n LANGUAGE plpgsql\\n SET search_path TO ''\\nAS $function$\\r\\nDECLARE\\r\\n  a public.jmcwc_attempts;\\r\\n  qs jsonb;\\r\\n  item jsonb;\\r\\n  q jsonb;\\r\\n  m numeric;\\r\\n  maximum numeric:=0;\\r\\n  earned numeric:=0;\\r\\n  c integer:=0;\\r\\n  h integer:=0;\\r\\n  w integer:=0;\\r\\n  sk integer:=0;\\r\\n  blank boolean;\\r\\nBEGIN\\r\\n  PERFORM pg_advisory_xact_lock(\\r\\n    hashtextextended(p_student::text,172026)\\r\\n  );\\r\\n\\r\\n  SELECT * INTO a\\r\\n  FROM public.jmcwc_attempts\\r\\n  WHERE id=p_attempt AND student_id=p_student\\r\\n  FOR UPDATE;\\r\\n\\r\\n  IF NOT FOUND THEN\\r\\n    RAISE EXCEPTION 'Round not found.';\\r\\n  END IF;\\r\\n\\r\\n  IF a.status='submitted' THEN\\r\\n    RETURN;\\r\\n  END IF;\\r\\n\\r\\n  IF a.status<>'grading'\\r\\n     OR a.revision IS DISTINCT FROM p_revision\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Grading snapshot changed.';\\r\\n  END IF;\\r\\n\\r\\n  SELECT questions INTO qs\\r\\n  FROM public.jmcwc_payloads\\r\\n  WHERE attempt_id=a.id;\\r\\n\\r\\n  IF jsonb_typeof(p_items) IS DISTINCT FROM 'array' THEN\\r\\n    RAISE EXCEPTION 'Invalid grading output.';\\r\\n  END IF;\\r\\n\\r\\n  IF jsonb_array_length(p_items)<>jsonb_array_length(qs)\\r\\n     OR (\\r\\n       SELECT count(DISTINCT x->>'question_id')\\r\\n       FROM jsonb_array_elements(p_items) x\\r\\n     )<>jsonb_array_length(qs)\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Grade every question exactly once.';\\r\\n  END IF;\\r\\n\\r\\n  FOR item IN\\r\\n    SELECT * FROM jsonb_array_elements(p_items)\\r\\n  LOOP\\r\\n    SELECT value INTO q\\r\\n    FROM jsonb_array_elements(qs)\\r\\n    WHERE value->>'id'=item->>'question_id';\\r\\n\\r\\n    IF NOT FOUND\\r\\n       OR jsonb_typeof(item->'award') IS DISTINCT FROM 'number'\\r\\n       OR coalesce(item->>'verdict','')\\r\\n            NOT IN ('correct','partial','wrong','skipped')\\r\\n    THEN\\r\\n      RAISE EXCEPTION 'Invalid mark.';\\r\\n    END IF;\\r\\n\\r\\n    m:=(q->>'max_marks')::numeric;\\r\\n    blank:=coalesce(btrim(a.answers->>(q->>'id')),'')='';\\r\\n\\r\\n    IF (item->>'award')::numeric<>(\\r\\n      CASE item->>'verdict'\\r\\n        WHEN 'correct' THEN m\\r\\n        WHEN 'partial' THEN m/2\\r\\n        ELSE 0\\r\\n      END\\r\\n    )\\r\\n    OR (blank AND item->>'verdict'<>'skipped')\\r\\n    OR (NOT blank AND item->>'verdict'='skipped')\\r\\n    THEN\\r\\n      RAISE EXCEPTION\\r\\n        'Inconsistent mark or blank-answer classification.';\\r\\n    END IF;\\r\\n\\r\\n    maximum:=maximum+m;\\r\\n    earned:=earned+(item->>'award')::numeric;\\r\\n\\r\\n    CASE item->>'verdict'\\r\\n      WHEN 'correct' THEN c:=c+1;\\r\\n      WHEN 'partial' THEN h:=h+1;\\r\\n      WHEN 'wrong' THEN w:=w+1;\\r\\n      ELSE sk:=sk+1;\\r\\n    END CASE;\\r\\n  END LOOP;\\r\\n\\r\\n  INSERT INTO public.jmcwc_scores(\\r\\n    attempt_id,marks,max_marks,correct,partial,wrong,skipped,items\\r\\n  )\\r\\n  VALUES(a.id,earned,maximum,c,h,w,sk,p_items);\\r\\n\\r\\n  UPDATE public.jmcwc_attempts\\r\\n  SET status='submitted',revision=revision+1\\r\\n  WHERE id=a.id;\\r\\nEND $function$\\n",<br>            "permissions": "{postgres=X/postgres,service_role=X/postgres}",<br>            "security_definer": false,<br>            "identity_arguments": "p_student uuid, p_attempt uuid, p_revision bigint, p_items jsonb"<br>        },<br>        {<br>            "name": "jmcwc_list",<br>            "definition": "CREATE OR REPLACE FUNCTION public.jmcwc_list(p_student uuid, p_offset integer DEFAULT 0)\\n RETURNS SETOF jmcwc_attempts\\n LANGUAGE plpgsql\\n SET search_path TO ''\\nAS $function$\\r\\nDECLARE\\r\\n  a uuid;\\r\\nBEGIN\\r\\n  PERFORM pg_advisory_xact_lock(\\r\\n    hashtextextended(p_student::text,172026)\\r\\n  );\\r\\n\\r\\n  PERFORM public.jmcwc_check_student(p_student);\\r\\n\\r\\n  FOR a IN\\r\\n    SELECT id\\r\\n    FROM public.jmcwc_attempts\\r\\n    WHERE student_id=p_student AND status='running'\\r\\n  LOOP\\r\\n    PERFORM public.jmcwc_tick(a);\\r\\n  END LOOP;\\r\\n\\r\\n  RETURN QUERY\\r\\n  SELECT *\\r\\n  FROM public.jmcwc_attempts\\r\\n  WHERE student_id=p_student\\r\\n  ORDER BY created_at DESC,id\\r\\n  LIMIT 50\\r\\n  OFFSET greatest(0,least(coalesce(p_offset,0),100000));\\r\\nEND $function$\\n",<br>            "permissions": "{postgres=X/postgres,service_role=X/postgres}",<br>            "security_definer": false,<br>            "identity_arguments": "p_student uuid, p_offset integer"<br>        },<br>        {<br>            "name": "jmcwc_paper_guard",<br>            "definition": "CREATE OR REPLACE FUNCTION public.jmcwc_paper_guard()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO ''\\nAS $function$\\r\\nDECLARE\\r\\n  s jsonb;\\r\\n  q jsonb;\\r\\n  n integer := 0;\\r\\nBEGIN\\r\\n  IF TG_OP = 'UPDATE' AND OLD.published THEN\\r\\n    RAISE EXCEPTION\\r\\n      'Published papers are immutable; create a new version.';\\r\\n  END IF;\\r\\n\\r\\n  IF NEW.published THEN\\r\\n    IF jsonb_typeof(NEW.spec->'sections')\\r\\n         IS DISTINCT FROM 'array'\\r\\n    THEN\\r\\n      RAISE EXCEPTION 'Paper sections must be an array.';\\r\\n    END IF;\\r\\n\\r\\n    IF jsonb_array_length(NEW.spec->'sections') <> 23 THEN\\r\\n      RAISE EXCEPTION\\r\\n        'A complete paper needs the 23 visible workbook sections.';\\r\\n    END IF;\\r\\n\\r\\n    IF (\\r\\n      SELECT count(DISTINCT x->>'key')\\r\\n      FROM jsonb_array_elements(NEW.spec->'sections') x\\r\\n    ) <> 23\\r\\n    THEN\\r\\n      RAISE EXCEPTION 'Duplicate or missing sections.';\\r\\n    END IF;\\r\\n\\r\\n    FOR s IN\\r\\n      SELECT *\\r\\n      FROM jsonb_array_elements(NEW.spec->'sections')\\r\\n    LOOP\\r\\n      IF NOT EXISTS (\\r\\n        SELECT 1\\r\\n        FROM public.jmcwc_categories\\r\\n        WHERE key = s->>'key'\\r\\n      )\\r\\n      THEN\\r\\n        RAISE EXCEPTION 'Invalid section.';\\r\\n      END IF;\\r\\n\\r\\n      IF jsonb_typeof(s->'questions')\\r\\n           IS DISTINCT FROM 'array'\\r\\n      THEN\\r\\n        RAISE EXCEPTION 'Section questions must be an array.';\\r\\n      END IF;\\r\\n\\r\\n      IF jsonb_array_length(s->'questions')\\r\\n           NOT BETWEEN 1 AND 250\\r\\n      THEN\\r\\n        RAISE EXCEPTION 'Invalid question count.';\\r\\n      END IF;\\r\\n\\r\\n      IF (\\r\\n        SELECT count(DISTINCT x->>'slot')\\r\\n        FROM jsonb_array_elements(s->'questions') x\\r\\n      ) <> jsonb_array_length(s->'questions')\\r\\n      THEN\\r\\n        RAISE EXCEPTION 'Duplicate or missing slots.';\\r\\n      END IF;\\r\\n\\r\\n      FOR q IN\\r\\n        SELECT *\\r\\n        FROM jsonb_array_elements(s->'questions')\\r\\n      LOOP\\r\\n        IF coalesce(q->>'slot','') = ''\\r\\n           OR coalesce(q->>'generator','') = ''\\r\\n        THEN\\r\\n          RAISE EXCEPTION 'Invalid question specification.';\\r\\n        END IF;\\r\\n\\r\\n        PERFORM public.jmcwc_validate_marks(\\r\\n          s->>'key', q\\r\\n        );\\r\\n\\r\\n        n := n + 1;\\r\\n      END LOOP;\\r\\n    END LOOP;\\r\\n\\r\\n    IF n > 2000 THEN\\r\\n      RAISE EXCEPTION 'Paper is too large.';\\r\\n    END IF;\\r\\n  END IF;\\r\\n\\r\\n  RETURN NEW;\\r\\nEND;\\r\\n$function$\\n",<br>            "permissions": "{postgres=X/postgres,service_role=X/postgres}",<br>            "security_definer": false,<br>            "identity_arguments": ""<br>        },<br>        {<br>            "name": "jmcwc_tick",<br>            "definition": "CREATE OR REPLACE FUNCTION public.jmcwc_tick(p_attempt uuid)\\n RETURNS void\\n LANGUAGE plpgsql\\n SET search_path TO ''\\nAS $function$\\r\\nDECLARE\\r\\n  a public.jmcwc_attempts;\\r\\n  t timestamptz:=clock_timestamp();\\r\\n  gap bigint;\\r\\nBEGIN\\r\\n  SELECT * INTO a\\r\\n  FROM public.jmcwc_attempts\\r\\n  WHERE id=p_attempt\\r\\n  FOR UPDATE;\\r\\n\\r\\n  IF NOT FOUND OR a.status<>'running' THEN\\r\\n    RETURN;\\r\\n  END IF;\\r\\n\\r\\n  gap:=greatest(\\r\\n    0,\\r\\n    floor(extract(epoch FROM t-a.last_seen_at)*1000)::bigint\\r\\n  );\\r\\n\\r\\n  IF gap>25000 THEN\\r\\n    UPDATE public.jmcwc_attempts\\r\\n    SET status='paused',\\r\\n        lease_id=NULL,\\r\\n        last_seen_at=NULL,\\r\\n        revision=revision+1\\r\\n    WHERE id=a.id;\\r\\n  ELSE\\r\\n    a.active_ms:=a.active_ms+gap;\\r\\n\\r\\n    IF a.mode='flat' AND a.active_ms>=7200000 THEN\\r\\n      UPDATE public.jmcwc_attempts\\r\\n      SET active_ms=7200000,\\r\\n          status='grading',\\r\\n          lease_id=NULL,\\r\\n          last_seen_at=NULL,\\r\\n          finished_at=t,\\r\\n          submitted_reason='time_limit',\\r\\n          revision=revision+1\\r\\n      WHERE id=a.id;\\r\\n    ELSE\\r\\n      UPDATE public.jmcwc_attempts\\r\\n      SET active_ms=a.active_ms,\\r\\n          last_seen_at=t\\r\\n      WHERE id=a.id;\\r\\n    END IF;\\r\\n  END IF;\\r\\nEND $function$\\n",<br>            "permissions": "{postgres=X/postgres,service_role=X/postgres}",<br>            "security_definer": false,<br>            "identity_arguments": "p_attempt uuid"<br>        },<br>        {<br>            "name": "jmcwc_validate_marks",<br>            "definition": "CREATE OR REPLACE FUNCTION public.jmcwc_validate_marks(p_category text, p_slot jsonb, p_question_marks numeric DEFAULT NULL::numeric)\\n RETURNS void\\n LANGUAGE plpgsql\\n SET search_path TO ''\\nAS $function$\\r\\nDECLARE\\r\\n  params jsonb;\\r\\n  scoring_mode text;\\r\\n  rule_name text;\\r\\n  bounds jsonb;\\r\\n  baseline numeric;\\r\\n  lower_mark numeric;\\r\\n  upper_mark numeric;\\r\\nBEGIN\\r\\n  IF jsonb_typeof(p_slot) IS DISTINCT FROM 'object' THEN\\r\\n    RAISE EXCEPTION 'Invalid scoring slot.';\\r\\n  END IF;\\r\\n\\r\\n  params := p_slot->'parameters';\\r\\n\\r\\n  IF jsonb_typeof(params) IS DISTINCT FROM 'object' THEN\\r\\n    RAISE EXCEPTION 'Slot parameters must be an object.';\\r\\n  END IF;\\r\\n\\r\\n  -- Avoid two competing metadata locations.\\r\\n  IF p_slot ? 'scoring_mode'\\r\\n     OR p_slot ? 'mark_rule'\\r\\n     OR p_slot ? 'mark_range'\\r\\n  THEN\\r\\n    RAISE EXCEPTION\\r\\n      'Scoring metadata must be inside slot.parameters.';\\r\\n  END IF;\\r\\n\\r\\n  IF jsonb_typeof(p_slot->'max_marks')\\r\\n       IS DISTINCT FROM 'number'\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Blueprint max_marks must be numeric.';\\r\\n  END IF;\\r\\n\\r\\n  baseline := (p_slot->>'max_marks')::numeric;\\r\\n\\r\\n  IF baseline <= 0 OR baseline <> trunc(baseline) THEN\\r\\n    RAISE EXCEPTION\\r\\n      'Blueprint max_marks must be a positive integer.';\\r\\n  END IF;\\r\\n\\r\\n  IF params ? 'scoring_mode' THEN\\r\\n    IF jsonb_typeof(params->'scoring_mode')\\r\\n         IS DISTINCT FROM 'string'\\r\\n    THEN\\r\\n      RAISE EXCEPTION 'Invalid scoring_mode.';\\r\\n    END IF;\\r\\n\\r\\n    scoring_mode := params->>'scoring_mode';\\r\\n  ELSE\\r\\n    scoring_mode := 'fixed';\\r\\n  END IF;\\r\\n\\r\\n  IF scoring_mode NOT IN ('fixed','dynamic') THEN\\r\\n    RAISE EXCEPTION 'Unknown scoring_mode.';\\r\\n  END IF;\\r\\n\\r\\n  IF scoring_mode = 'fixed' THEN\\r\\n    IF params ? 'mark_rule' OR params ? 'mark_range' THEN\\r\\n      RAISE EXCEPTION\\r\\n        'Fixed slots must not declare dynamic scoring metadata.';\\r\\n    END IF;\\r\\n\\r\\n    IF p_question_marks IS NOT NULL THEN\\r\\n      IF p_question_marks::text IN ('NaN','Infinity','-Infinity')\\r\\n         OR p_question_marks <= 0\\r\\n         OR p_question_marks <> trunc(p_question_marks)\\r\\n         OR p_question_marks <> baseline\\r\\n      THEN\\r\\n        RAISE EXCEPTION\\r\\n          'Fixed question marks must equal blueprint max_marks.';\\r\\n      END IF;\\r\\n    END IF;\\r\\n\\r\\n    RETURN;\\r\\n  END IF;\\r\\n\\r\\n  IF jsonb_typeof(params->'mark_rule')\\r\\n       IS DISTINCT FROM 'string'\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'Dynamic slot needs a mark_rule.';\\r\\n  END IF;\\r\\n\\r\\n  rule_name := params->>'mark_rule';\\r\\n\\r\\n  IF NOT (\\r\\n    (\\r\\n      p_category = 'multiplication'\\r\\n      AND rule_name = 'multiplication_digits_product'\\r\\n    )\\r\\n    OR (\\r\\n      p_category = 'prime_factors'\\r\\n      AND rule_name = 'prime_factors_target_scale'\\r\\n    )\\r\\n    OR (\\r\\n      p_category = 'approximation'\\r\\n      AND rule_name = 'approximation_product_digits'\\r\\n    )\\r\\n    OR (\\r\\n      p_category = 'sum_squares'\\r\\n      AND rule_name IN (\\r\\n        'sum_squares_j1_decomposition',\\r\\n        'sum_squares_j2_target',\\r\\n        'sum_squares_sr_target'\\r\\n      )\\r\\n    )\\r\\n  ) OR p_category IS NULL\\r\\n  THEN\\r\\n    RAISE EXCEPTION\\r\\n      'Unrecognized scoring rule % for category %.',\\r\\n      rule_name, p_category;\\r\\n  END IF;\\r\\n\\r\\n  bounds := params->'mark_range';\\r\\n\\r\\n  IF jsonb_typeof(bounds) IS DISTINCT FROM 'array' THEN\\r\\n    RAISE EXCEPTION 'mark_range must be an array.';\\r\\n  END IF;\\r\\n\\r\\n  IF jsonb_array_length(bounds) <> 2 THEN\\r\\n    RAISE EXCEPTION 'mark_range must contain exactly two bounds.';\\r\\n  END IF;\\r\\n\\r\\n  IF jsonb_typeof(bounds->0) IS DISTINCT FROM 'number'\\r\\n     OR jsonb_typeof(bounds->1) IS DISTINCT FROM 'number'\\r\\n  THEN\\r\\n    RAISE EXCEPTION 'mark_range bounds must be numeric.';\\r\\n  END IF;\\r\\n\\r\\n  lower_mark := (bounds->>0)::numeric;\\r\\n  upper_mark := (bounds->>1)::numeric;\\r\\n\\r\\n  IF lower_mark <= 0\\r\\n     OR upper_mark <= 0\\r\\n     OR lower_mark <> trunc(lower_mark)\\r\\n     OR upper_mark <> trunc(upper_mark)\\r\\n     OR lower_mark > upper_mark\\r\\n  THEN\\r\\n    RAISE EXCEPTION\\r\\n      'mark_range needs ordered positive integer bounds.';\\r\\n  END IF;\\r\\n\\r\\n  IF baseline < lower_mark OR baseline > upper_mark THEN\\r\\n    RAISE EXCEPTION\\r\\n      'Blueprint baseline marks must fall inside mark_range.';\\r\\n  END IF;\\r\\n\\r\\n  IF p_question_marks IS NOT NULL THEN\\r\\n    IF p_question_marks::text IN ('NaN','Infinity','-Infinity')\\r\\n       OR p_question_marks <= 0\\r\\n       OR p_question_marks <> trunc(p_question_marks)\\r\\n       OR p_question_marks < lower_mark\\r\\n       OR p_question_marks > upper_mark\\r\\n    THEN\\r\\n      RAISE EXCEPTION\\r\\n        'Dynamic question marks must be an integer within mark_range.';\\r\\n    END IF;\\r\\n  END IF;\\r\\nEND;\\r\\n$function$\\n",<br>            "permissions": "{postgres=X/postgres,service_role=X/postgres}",<br>            "security_definer": false,<br>            "identity_arguments": "p_category text, p_slot jsonb, p_question_marks numeric"<br>        }<br>    ]<br>} |