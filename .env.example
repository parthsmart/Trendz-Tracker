# ==============================================================================
# Trendz Tracker - Environment Variables
# ==============================================================================

# SUPABASE_URL: Your Supabase Project URL
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_ANON_KEY: Client-side anon public key
# Safe to expose in the browser (also referenced in js/config.js)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY: Required for Vercel Serverless Functions (/api/*)
# Used to create student users and reset passwords.
# NEVER expose this key to the browser or commit to public git repositories!
# Set this in your Vercel Dashboard -> Settings -> Environment Variables.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# PORT: Server port (defaults to 3000)
PORT=3000
